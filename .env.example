# Google reCAPTCHA v3 (score-based): https://www.google.com/recaptcha/admin
# Domains: localhost, 127.0.0.1, your-app.vercel.app
# Leave empty locally to use Google's official test keys (always pass).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Preferred mail provider (free): https://web3forms.com — paste Access Key
# If set, FormSubmit is not used.
WEB3FORMS_ACCESS_KEY=

# Optional fallback origin (unused when Web3Forms is configured)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
