# Google reCAPTCHA v3 (score-based): https://www.google.com/recaptcha/admin
# Domains: localhost, 127.0.0.1, your-app.vercel.app
# Leave empty locally to use Google's official test keys (always pass).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Web3Forms access key (public by design — used in the browser).
# Free plan blocks server-side calls; the form submits from the client.
# https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
